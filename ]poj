            if not config.oreo.LM then endle(0.1) end
            high(false)
        end
        if animation and animation.AnimationId:match(id) and config.king.enable and not incooldown then
            if not isokay() then return end
            if techCooldown then return end
            startTechCooldown()
            task.spawn(teleportToNearestHead)
            task.wait(config.king.startdelay)
            fireDash(); high(true)
            task.wait(config.king.flickdelay)
            jump30(); flipCamera(); task.wait(0.2); high(false)
        end
        if animation and animation.AnimationId:match(id) and config.supa.enable and not incooldown then
            if not isokay() then return end
            if techCooldown then return end
            startTechCooldown()
            task.wait(0.1); executeCrystalSupa(oreojump)
        end
        if animation and animation.AnimationId:match(id) and config.kiba.enable and not incooldown then
            if not isokay() then return end
            if techCooldown then return end
            startTechCooldown()
            task.delay(0.32, function()
                if not config.kiba.enable then return end
                fireDash()
                local target = kibaNearestTarget(10)
                if target then kibaStartFollow(target); task.delay(0.5, kibaCleanup) end
            end)
        end
        if animation and animation.AnimationId:match(id) and config.loopdashv2.enable and not incooldown then
            task.spawn(executeLoopdashV2)
        end
        if animation and animation.AnimationId:match(id) and config.king2.enable and not incooldown then
            task.spawn(executeKing2)
        end
        if animation and animation.AnimationId:match(lethal) and config.il.enable and not incooldown then
            if not isokay() then return end
            if techCooldown then return end
            startTechCooldown()
            task.spawn(function()
                local shiftState = getgenv()._grabShiftlockState and getgenv()._grabShiftlockState()
                task.wait(config.il.startdelay)
                local char = player.Character
                local rootPart = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not (char and rootPart and hum) then
                    if shiftState and getgenv()._restoreShiftlockState then getgenv()._restoreShiftlockState(shiftState) end
