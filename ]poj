    if item then pcall(function() item.arrow:Destroy() end); pcall(function() item.dist:Destroy() end); Offscreen.items[p] = nil end
end
local function clearOffscreenArrows()
    for p in pairs(Offscreen.items) do removeOffscreenArrow(p) end
    Offscreen.items = {}
    if Offscreen.gui then pcall(function() Offscreen.gui:Destroy() end) Offscreen.gui = nil end
end
local function stopOffscreen()
    if Offscreen.conn then pcall(function() Offscreen.conn:Disconnect() end) Offscreen.conn = nil end
    clearOffscreenArrows()
end
local function ensureOffscreenGui()
    local pg = LocalPlayer_esp:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end
    local g = Offscreen.gui
    if g then
        local ok = pcall(function() return g.Parent end)
        if ok and g.Parent == pg then if g.Enabled == false then g.Enabled = true end; return true end
    end
    for p in pairs(Offscreen.items) do removeOffscreenArrow(p) end
    Offscreen.items = {}
    if g then pcall(function() g:Destroy() end) end
    local ng = Instance.new("ScreenGui")
    ng.Name = "Arrows_" .. tostring(math.random(100000, 999999))
    ng.ResetOnSpawn = false; ng.IgnoreGuiInset = true; ng.Enabled = true
    ng.ZIndexBehavior = Enum.ZIndexBehavior.Sibling; ng.Parent = pg
    Offscreen.gui = ng
    return true
end
local function createOffscreenArrow(p)
    local arrow = Instance.new("TextLabel")
    arrow.Name = "OffscreenArrow"; arrow.BackgroundTransparency = 1; arrow.AnchorPoint = Vector2.new(0.5, 0.5)
    arrow.Text = "\226\150\178"; arrow.Font = Enum.Font.GothamBold; arrow.TextStrokeTransparency = 0.3
    arrow.TextStrokeColor3 = Color3.new(0,0,0); arrow.Visible = false; arrow.Parent = Offscreen.gui
    local dist = Instance.new("TextLabel")
    dist.Name = "OffscreenArrowDist"; dist.BackgroundTransparency = 1; dist.AnchorPoint = Vector2.new(0.5, 0.5)
    dist.Size = UDim2.fromOffset(60, 14); dist.Font = Enum.Font.GothamBold; dist.TextSize = 11
    dist.TextStrokeTransparency = 0.3; dist.TextStrokeColor3 = Color3.new(0,0,0)
    dist.Visible = false; dist.Parent = Offscreen.gui
    local item = { arrow = arrow, dist = dist }
    Offscreen.items[p] = item
    return item
end
local function updateOffscreenArrows(dt)
    if not espConfig.prefOffscreenArrows then stopOffscreen() return end
    if not espConfig.espMasterEnabled then
        if Offscreen.gui or next(Offscreen.items) then clearOffscreenArrows() end
        return
    end
    Offscreen.acc = Offscreen.acc + dt
    if Offscreen.acc < 1 / 60 then return end
    Offscreen.acc = 0
    local cam = workspace.CurrentCamera
    if not cam then return end
    if not ensureOffscreenGui() then return end
    local vp = cam.ViewportSize
    local ctr = vp / 2
    local aS = espConfig.offArrowSize or 18
    local maxR = math.max(math.min(vp.X, vp.Y) / 2 - aS, 20)
    local rad = math.clamp(espConfig.offArrowRadius or 200, 20, maxR)
    local cCF = cam.CFrame
    local seen = {}
    for _, p in ipairs(getTargets()) do
        if p ~= LocalPlayer_esp and isValidTarget(p) and isAlive(p) then
            local ch = resolveCharacter(p)
            local root = ch and (ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head"))
            if root then
                seen[p] = true
                local sp, on = cam:WorldToViewportPoint(root.Position)
                local isOn = on and sp.Z > 0 and sp.X >= 0 and sp.X <= vp.X and sp.Y >= 0 and sp.Y <= vp.Y
                local item = Offscreen.items[p]
                if item and (item.arrow.Parent ~= Offscreen.gui or item.dist.Parent ~= Offscreen.gui) then
                    removeOffscreenArrow(p); item = nil
                end
                if isOn then
                    if item then item.arrow.Visible = false; item.dist.Visible = false end
                else
                    item = item or createOffscreenArrow(p)
                    local lp = cCF:PointToObjectSpace(root.Position)
                    local d2 = Vector2.new(lp.X, -lp.Y)
                    if d2.Magnitude < 1e-4 then d2 = Vector2.new(0, 1) end
                    d2 = d2.Unit
                    local p2 = ctr + d2 * rad
                    local color = getOverrideColor(p) or espConfig.arrowColor
                    item.arrow.TextSize = aS; item.arrow.Size = UDim2.fromOffset(aS * 1.5, aS * 1.5)
                    item.arrow.Position = UDim2.fromOffset(p2.X, p2.Y)
                    item.arrow.Rotation = math.deg(math.atan2(d2.X, -d2.Y))
                    item.arrow.TextColor3 = color; item.arrow.Visible = true
                    if espConfig.offArrowShowDistance then
                        local dp = p2 - d2 * (aS * 1.1)
                        item.dist.Text = string.format("%dm", math.floor((root.Position - cCF.Position).Magnitude))
                        item.dist.Position = UDim2.fromOffset(dp.X, dp.Y); item.dist.TextColor3 = color; item.dist.Visible = true
                    else item.dist.Visible = false end
                end
            end
        end
    end
    for p in pairs(Offscreen.items) do if not seen[p] then removeOffscreenArrow(p) end end
end
local function toggleOffscreenArrows()
    if espConfig.espMasterEnabled and espConfig.prefOffscreenArrows then
        Offscreen.acc = 1e9
        if Offscreen.conn then
            local ok, c = pcall(function() return Offscreen.conn.Connected end)
            if ok and c then return end
            Offscreen.conn = nil
        end
        Offscreen.conn = RunService_esp.RenderStepped:Connect(function(dt) pcall(updateOffscreenArrows, dt) end)
    else stopOffscreen() end
end
local function fullESPRefresh()
    if not espConfig.espMasterEnabled then
        for p in pairs(espConfig.espData) do destroyESP(p) end
        for p in pairs(espConfig.highlightData) do destroyHighlight(p) end
        for p in pairs(espConfig.lineESPData) do destroyTracer(p) end
        for p in pairs(espConfig.characterESPData) do destroyCharacterESP(p) end
        espConfig.espData = {}; espConfig.highlightData = {}; espConfig.lineESPData = {}; espConfig.characterESPData = {}
        return
    end
    local seen = {}
    for _, p in ipairs(getTargets()) do
        if isValidTarget(p) and isAlive(p) then
            seen[p] = true
            if (espConfig.prefTextESP or espConfig.prefBoxESP or espConfig.prefHealthESP or espConfig.prefHeadDotESP) and not espConfig.espData[p] then createESP(p) end
            if espConfig.prefHighlightESP and not espConfig.highlightData[p] then createHighlight(p) end
            if espConfig.lineESPEnabled and not espConfig.lineESPData[p] then createTracer(p) end
            if espConfig.prefCharacterESP and not espConfig.characterESPData[p] then updateCharacterESP(p) end
        end
    end
    for p in pairs(espConfig.espData) do if not seen[p] then destroyESP(p) end end
    for p in pairs(espConfig.highlightData) do if not seen[p] then destroyHighlight(p) end end
    for p in pairs(espConfig.lineESPData) do if not seen[p] then destroyTracer(p) end end
    for p in pairs(espConfig.characterESPData) do if not seen[p] then destroyCharacterESP(p) end end
    refreshESPColors()
end
local function setESPEnabled(state)
    espConfig.espMasterEnabled = state
    if not state then
        for p in pairs(espConfig.espData) do destroyESP(p) end
        for p in pairs(espConfig.highlightData) do destroyHighlight(p) end
        for p in pairs(espConfig.lineESPData) do destroyTracer(p) end
        for p in pairs(espConfig.characterESPData) do destroyCharacterESP(p) end
        espConfig.espData = {}; espConfig.highlightData = {}; espConfig.lineESPData = {}; espConfig.characterESPData = {}
    else
        if espConfig.prefHighlightESP then
            for _, p in ipairs(getTargets()) do if isValidTarget(p) and resolveCharacter(p) then createHighlight(p) end end
        end
        if espConfig.prefTextESP or espConfig.prefBoxESP or espConfig.prefHealthESP or espConfig.prefHeadDotESP then
            for _, p in ipairs(getTargets()) do if isValidTarget(p) then createESP(p) end end
        end
        if espConfig.lineESPEnabled then
            for _, p in ipairs(getTargets()) do if isValidTarget(p) and isAlive(p) then createTracer(p) end end
        end
        if espConfig.prefCharacterESP then updateAllCharacterESP() end
    end
    toggleOffscreenArrows()
    refreshESPColors()
end
local function watchPlayer(p)
    if p == LocalPlayer_esp then return end
    if espRuntime.playerConnections[p] then
        for _, c in ipairs(espRuntime.playerConnections[p]) do pcall(function() c:Disconnect() end) end
    end
    espRuntime.playerConnections[p] = {}
    local function refreshNow()
        if espConfig.espMasterEnabled then
            destroyESP(p); destroyHighlight(p); destroyCharacterESP(p)
            if espConfig.prefTextESP or espConfig.prefBoxESP or espConfig.prefHealthESP or espConfig.prefHeadDotESP then
                if isValidTarget(p) then createESP(p) end
            end
            if espConfig.prefHighlightESP and p.Character and isValidTarget(p) then createHighlight(p) end
            if espConfig.prefCharacterESP then updateCharacterESP(p) end
        end
    end
    refreshNow()
    local c1 = p.CharacterAdded:Connect(function(_)
        task.wait(0.5); destroyESP(p); destroyHighlight(p); destroyCharacterESP(p); task.wait(0.1)
        if espConfig.espMasterEnabled then
            if espConfig.prefTextESP or espConfig.prefBoxESP or espConfig.prefHealthESP or espConfig.prefHeadDotESP then
                if isValidTarget(p) then createESP(p) end
            end
            if espConfig.prefHighlightESP and p.Character and isValidTarget(p) then createHighlight(p) end
            if espConfig.prefCharacterESP then updateCharacterESP(p) end
        end
    end)
    table.insert(espRuntime.playerConnections[p], c1)
    local c2 = p.CharacterRemoving:Connect(function(_) destroyESP(p); destroyHighlight(p); destroyCharacterESP(p) end)
    table.insert(espRuntime.playerConnections[p], c2)
    local c3 = p:GetPropertyChangedSignal("Team"):Connect(function() task.wait(0.05); refreshNow() end)
    table.insert(espRuntime.playerConnections[p], c3)
end
local function unwatchPlayer(p)
    if not p then return end
    destroyESP(p); destroyHighlight(p); destroyTracer(p); destroyCharacterESP(p)
    if espRuntime.playerConnections[p] then
        for _, c in ipairs(espRuntime.playerConnections[p]) do pcall(function() c:Disconnect() end) end
        espRuntime.playerConnections[p] = nil
    end
end
