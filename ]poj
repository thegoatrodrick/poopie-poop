local invisState = {
    active = false, busy = false, cachedTrack = nil, cachedHum = nil, lastCF = nil,
    partConns = {}, invisModel = nil, invisHum = nil, invisPart = nil, hbConn = nil, charAddedConn = nil,
}
do
    local model = Instance.new("Model")
    model.Name = "_InvisibleModel"; model.Parent = workspace
    local h = Instance.new("Humanoid", model)
    local part = Instance.new("Part", model)
    part.Name = "HumanoidRootPart"; part.CanCollide = false; part.Transparency = 1; part.Anchored = true
    part.Size = Vector3.new(2, 2, 1)
    invisState.invisModel = model; invisState.invisHum = h; invisState.invisPart = part
    getgenv().InvisHumanoid = h; getgenv().InvisPart30 = part
end
local function _invisSoftReset()
    if invisState.cachedTrack then
        pcall(function() if invisState.cachedTrack.IsPlaying then invisState.cachedTrack:Stop() end end)
        invisState.cachedTrack = nil
    end
    invisState.cachedHum = nil; invisState.lastCF = nil; invisState.busy = false
end
local function _invisStop()
    if not invisState.active then return end
    invisState.active = false; invisState.busy = false
    if invisState.cachedTrack then
        pcall(function() if invisState.cachedTrack.IsPlaying then invisState.cachedTrack:Stop() end end)
        invisState.cachedTrack = nil
    end
    invisState.cachedHum = nil
    local char = player.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and invisState.lastCF then pcall(function() root.CFrame = invisState.lastCF end) end
        invisState.lastCF = nil
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then pcall(function() workspace.CurrentCamera.CameraSubject = h end) end
        pcall(function() char:SetAttribute("NoHeadLerp", false) end)
        for _, c in ipairs(invisState.partConns) do pcall(function() c:Disconnect() end) end
        table.clear(invisState.partConns)
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.LocalTransparencyModifier = 0 end
        end
    end
end
local function _invisHookPart(p)
    if not p:IsA("BasePart") then return end
    if p.Name == "HumanoidRootPart" then return end
    if p.Transparency == 1 then return end
    if p.Name:lower():find("hitbox") then return end
    p.LocalTransparencyModifier = 0.5
    local conn = p:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(function()
        if not invisState.active then return end
        if p.LocalTransparencyModifier ~= 0.5 then p.LocalTransparencyModifier = 0.5 end
    end)
    table.insert(invisState.partConns, conn)
end
local function _invisHookChar(c)
    for _, p in ipairs(c:GetDescendants()) do _invisHookPart(p) end
    local conn = c.DescendantAdded:Connect(function(d) if invisState.active then _invisHookPart(d) end end)
    table.insert(invisState.partConns, conn)
end
local function _invisStart()
    if invisState.active then return end
    local char = player.Character
    if not char then return end
    local h = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not h or not root then return end
    invisState.active = true; invisState.busy = false
    getgenv().InvisActive = true
    _invisHookChar(char)
end
invisState.hbConn = RunService.Heartbeat:Connect(function()
    if not invisState.active then return end
    if invisState.busy then return end
    invisState.busy = true
    local char = player.Character
    if not char then invisState.busy = false return end
    local h = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not h or not root then invisState.busy = false return end
    if h.Health <= 0 then task.spawn(_invisSoftReset); invisState.busy = false; return end
    local realCF = root.CFrame; local realVel = root.Velocity
    invisState.lastCF = realCF
    local cam = workspace.CurrentCamera
    if invisState.cachedHum ~= h then
        if invisState.cachedTrack then
            pcall(function() if invisState.cachedTrack.IsPlaying then invisState.cachedTrack:Stop() end end)
            invisState.cachedTrack = nil
        end
        invisState.cachedHum = h
    end
    local animator = h:FindFirstChildOfClass("Animator")
    local invisAnim = nil
    if animator then
        if not invisState.cachedTrack or invisState.cachedTrack.Parent == nil then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://71181015443030"
            invisState.cachedTrack = animator:LoadAnimation(anim)
            invisState.cachedTrack.Priority = Enum.AnimationPriority.Action4
        end
        invisAnim = invisState.cachedTrack
        invisAnim:Play(); invisAnim.TimePosition = 13.45; invisAnim:AdjustSpeed(0); invisAnim:AdjustWeight(2e9)
    end
    if cam and invisState.invisHum then
        char:SetAttribute("NoHeadLerp", true)
        cam.CameraSubject = invisState.invisHum
        invisState.invisPart.CFrame = realCF
    end
    root.CFrame = realCF
    RunService.RenderStepped:Wait()
    if invisState.invisHum then invisState.invisHum.CameraOffset = h.CameraOffset end
    if cam and cam.CameraSubject == invisState.invisHum then
        char:SetAttribute("NoHeadLerp", false)
        cam.CameraSubject = h
    end
    if invisAnim and invisAnim.IsPlaying then pcall(function() invisAnim:Stop() end) end
    root.CFrame = realCF; root.Velocity = realVel
    invisState.busy = false
end)
invisState.charAddedConn = player.CharacterAdded:Connect(function(char)
    if invisState.active then
        _invisSoftReset()
        for _, c in ipairs(invisState.partConns) do pcall(function() c:Disconnect() end) end
        table.clear(invisState.partConns)
        task.defer(function()
            if not invisState.active then return end
            local c = player.Character
