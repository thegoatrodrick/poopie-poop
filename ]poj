                        local parent = d.Parent
                        local part
                        while parent do
                            if parent:IsA("BasePart") then part = parent; break end
                            if parent:IsA("Model") and parent.PrimaryPart then part = parent.PrimaryPart; break end
                            parent = parent.Parent
                        end
                        if part and (part.Position - hrp.Position).Magnitude <= autoKnockRange then
                            if (now - (autoKnockCooldowns[d] or 0)) > 0.5 then
                                autoKnockCooldowns[d] = now
                                pcall(function() fireproximityprompt(d) end)
                            end
                        end
                    end
                end
            end)
            WindUI:Notify({ Title = "Auto Knock", Content = "Enabled", Duration = 2, Icon = "check" })
