local function setupCharacter(character)
    local humanoid = character:WaitForChild("Humanoid")
    local animator = humanoid:WaitForChild("Animator")
    animator.AnimationPlayed:Connect(function(track)
        local animation = track.Animation
        if animation and animation.AnimationId:match("10479335397") then
            incooldown = true; showCountdown(); incooldown = false
        end
        if animation and animation.AnimationId:match(id) and config.oreo.enable and not incooldown then
