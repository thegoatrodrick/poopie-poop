        flyBV.Velocity = Vector3.zero; flyBV.Parent = hrp
        flyBG = Instance.new("BodyGyro"); flyBG.Name = "_FlyBG"
        flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        flyBG.P = 50000; flyBG.D = 500; flyBG.CFrame = hrp.CFrame; flyBG.Parent = hrp
        local lastHrp = hrp
        flyConn = RunService.RenderStepped:Connect(function()
            if not flyEnabled then stopFly(); return end
            local c, h = getChar()
            if not c or not h then return end
            if h ~= lastHrp then
                lastHrp = h
                if flyBV then flyBV:Destroy() end
                if flyBG then flyBG:Destroy() end
                flyBV = Instance.new("BodyVelocity"); flyBV.Name = "_FlyBV"
                flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                flyBV.Velocity = Vector3.zero; flyBV.Parent = h
