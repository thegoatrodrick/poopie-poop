local function getModelBounds(model)
    local mn = Vector3.new(math.huge, math.huge, math.huge)
    local mx = Vector3.new(-math.huge, -math.huge, -math.huge)
    local any = false
    for _, pt in ipairs(model:GetChildren()) do
        if pt:IsA("BasePart") and pt.Name ~= "HumanoidRootPart" then
            local cf, h = pt.CFrame, pt.Size * 0.5
            for dx = -1, 1, 2 do for dy = -1, 1, 2 do for dz = -1, 1, 2 do
                local c = cf * Vector3.new(dx*h.X, dy*h.Y, dz*h.Z)
                mn = Vector3.new(math.min(mn.X,c.X), math.min(mn.Y,c.Y), math.min(mn.Z,c.Z))
                mx = Vector3.new(math.max(mx.X,c.X), math.max(mx.Y,c.Y), math.max(mx.Z,c.Z))
                any = true
            end end end
        end
    end
    if not any then return nil, nil end
    return mn, mx
end
local function projectBounds(mn, mx, cam)
    local L, T, R, B = math.huge, math.huge, -math.huge, -math.huge
    local vis = false
    for dx = 0, 1 do for dy = 0, 1 do for dz = 0, 1 do
        local wp = Vector3.new(dx == 0 and mn.X or mx.X, dy == 0 and mn.Y or mx.Y, dz == 0 and mn.Z or mx.Z)
        local sp = cam:WorldToViewportPoint(wp)
        if sp.Z > 0 then
            vis = true
            L, T = math.min(L, sp.X), math.min(T, sp.Y)
            R, B = math.max(R, sp.X), math.max(B, sp.Y)
        end
    end end end
    if not vis then return nil end
    return L, T, R, B
end
