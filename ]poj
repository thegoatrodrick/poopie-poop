local function isokay()
    local character = player.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return false end
    local nearestRoot, shortestDistance = nil, math.huge
    local liveFolder = workspace:FindFirstChild("Live")
    if liveFolder then
        for _, target in ipairs(liveFolder:GetChildren()) do
            if target ~= character then
                local targetRoot = target:FindFirstChild("HumanoidRootPart")
                local humanoid = target:FindFirstChildOfClass("Humanoid")
                if targetRoot and humanoid and humanoid.Health > 0 then
                    local distance = (myRoot.Position - targetRoot.Position).Magnitude
                    if distance < shortestDistance then shortestDistance = distance; nearestRoot = targetRoot end
                end
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local targetRoot = p.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
            if targetRoot and humanoid and humanoid.Health > 0 then
                local distance = (myRoot.Position - targetRoot.Position).Magnitude
                if distance < shortestDistance then shortestDistance = distance; nearestRoot = targetRoot end
            end
        end
    end
    return nearestRoot ~= nil and shortestDistance <= 10
end

local function getTorsoTarget(range)
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local hrp = char.HumanoidRootPart
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    local parts = workspace:GetPartBoundsInRadius(hrp.Position, range or 8, params)
    local target = nil
    local dist = range or 8
    for _, part in pairs(parts) do
        local model = part:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") and model ~= char then
            local torso = model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") or model:FindFirstChild("HumanoidRootPart")
            if torso then
                local d = (hrp.Position - torso.Position).Magnitude
                if d < dist then dist = d; target = torso end
            end
        end
    end
    return target
end

local function techDashCancel(root, hum, connection, bav)
    if bav and bav.Parent then bav:Destroy() end
    if root and root.Parent then
        for _, obj in ipairs(root:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("LinearVelocity") or obj:IsA("BodyAngularVelocity") then
                obj:Destroy()
            end
        end
        root.AssemblyLinearVelocity = Vector3.zero
    end
    if hum then hum.AutoRotate = true end
    if connection and connection.Connected then connection:Disconnect() end
end

local function executeLoopdashV2()
    if not config.loopdashv2.enable then return end
    if not isokay() then return end
    if techCooldown then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    local torso = getTorsoTarget(8)
    if not torso then return end
    startTechCooldown()
    local cfg = config.loopdashv2
    task.wait(cfg.delay or 0.34)
    if not char.Parent or not torso.Parent then return end
    root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, cfg.jumppower, root.AssemblyLinearVelocity.Z)
    fireDash()
    local startT = tick()
    local forwardDir = (torso.Position - root.Position).Unit
    local sideVec = Vector3.new(-forwardDir.Z, 0, forwardDir.X)
    local bav = Instance.new("BodyAngularVelocity")
    bav.MaxTorque = Vector3.new(0, 1000000, 0)
    bav.P = 15000
    bav.Parent = root
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent or not torso or not torso.Parent or not hum or hum.Health <= 0 then
            if bav then bav:Destroy() end
            if hum then hum.AutoRotate = true end
            if conn then conn:Disconnect() end
            return
        end
        local elapsed = tick() - startT
        local torsoPos, rootPos = torso.Position, root.Position
        local distXZ = (Vector2.new(rootPos.X, rootPos.Z) - Vector2.new(torsoPos.X, torsoPos.Z)).Magnitude
        if elapsed > (cfg.stopdelay or 0.4) and distXZ < 2.2 then
            techDashCancel(root, hum, conn, bav)
            return
        end
        hum.AutoRotate = false
        local angle = (elapsed / 0.45) * (math.pi / 1.5)
        local radius = (cfg.accuracy or 15) * (1 - math.clamp(elapsed / 0.45, 0, 1))
        local targetLookPos = torsoPos + (sideVec * math.cos(angle) + forwardDir * math.sin(angle)) * radius
        local lookAtCF = CFrame.lookAt(rootPos, Vector3.new(targetLookPos.X, rootPos.Y, targetLookPos.Z))
        local relativeCF = root.CFrame:Inverse() * lookAtCF
        local _, y, _ = relativeCF:ToEulerAnglesXYZ()
        if bav and bav.Parent then
            bav.AngularVelocity = Vector3.new(0, y * 30, 0)
        end
        if elapsed > 1.5 then
            if bav then bav:Destroy() end
            hum.AutoRotate = true
            if conn then conn:Disconnect() end
        end
    end)
end

local function executeKing2()
