        end
    end,
})

local instantKnockConn = nil
local instantKnockOriginals = {}

instantKnockToggleRef = halloweenTab:Toggle({
    Title = "Instant knock", Value = false,
    Callback = function(state)
        local folder = workspace:FindFirstChild("HalloweenDoorTrees")
        if not folder then return end
        local function patch(prompt)
            if prompt:IsA("ProximityPrompt") and prompt.Name == "TrickOrTreat" then
                if instantKnockOriginals[prompt] == nil then instantKnockOriginals[prompt] = prompt.HoldDuration end
                prompt.HoldDuration = 0
            end
        end
        local function unpatch(prompt)
            if prompt:IsA("ProximityPrompt") and instantKnockOriginals[prompt] ~= nil then
                prompt.HoldDuration = instantKnockOriginals[prompt]; instantKnockOriginals[prompt] = nil
            end
        end
        if state then
            for _, d in ipairs(folder:GetDescendants()) do patch(d) end
            if instantKnockConn then instantKnockConn:Disconnect() end
            instantKnockConn = folder.DescendantAdded:Connect(function(d) task.defer(patch, d) end)
            WindUI:Notify({ Title = "Instant Knock", Content = "Enabled", Duration = 2, Icon = "check" })
        else
            if instantKnockConn then instantKnockConn:Disconnect() instantKnockConn = nil end
            for _, d in ipairs(folder:GetDescendants()) do unpatch(d) end
            WindUI:Notify({ Title = "Instant Knock", Content = "Disabled", Duration = 2, Icon = "x" })
        end
    end,
})

local treeEspEnabled = false
local treeEspHighlights = {}
local treeEspConn = nil

local function treeEspApply(model)
    if not treeEspEnabled then return end
    if not model or not model.Parent then return end
    if not model:IsA("Model") then return end
    if treeEspHighlights[model] then return end
    local hl = Instance.new("Highlight")
    hl.Name = "HalloweenTreeESP"
    hl.Adornee = model
    hl.FillColor = Color3.fromRGB(255, 220, 0)
    hl.OutlineColor = Color3.fromRGB(255, 220, 0)
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = model
    treeEspHighlights[model] = hl
end

halloweenTab:Toggle({
    Title = "Halloween Tree ESP", Value = false,
    Callback = function(state)
        treeEspEnabled = state
        local folder = workspace:FindFirstChild("HalloweenDoorTrees")
        if state then
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    if child:IsA("Model") then treeEspApply(child) end
                end
                if treeEspConn then treeEspConn:Disconnect() end
                treeEspConn = folder.ChildAdded:Connect(function(child)
                    if child:IsA("Model") then task.defer(treeEspApply, child) end
                end)
            end
            WindUI:Notify({ Title = "Tree ESP", Content = "Enabled", Duration = 2, Icon = "check" })
        else
            for model, hl in pairs(treeEspHighlights) do
                if hl and hl.Parent then hl:Destroy() end
            end
            table.clear(treeEspHighlights)
            if treeEspConn then treeEspConn:Disconnect() treeEspConn = nil end
            WindUI:Notify({ Title = "Tree ESP", Content = "Disabled", Duration = 2, Icon = "x" })
        end
    end,
})

