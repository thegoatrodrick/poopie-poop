    if not char.Parent or not torso.Parent then return end
    root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, cfg.jumppower, root.AssemblyLinearVelocity.Z)
    fireDash()
    local startT = tick()
    local flipped = false
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent or not torso or not torso.Parent or not hum or hum.Health <= 0 then
            if hum then hum.AutoRotate = true end
            if conn then conn:Disconnect() end
            return
        end
        local elapsed = tick() - startT
        local distXZ = (Vector2.new(root.Position.X, root.Position.Z) - Vector2.new(torso.Position.X, torso.Position.Z)).Magnitude
        if elapsed > (cfg.stopdelay or 0.4) and distXZ < 2.2 then
            techDashCancel(root, hum, conn)
            return
        end
        hum.AutoRotate = false
        if elapsed >= (cfg.flipdelay or 0.27) and not flipped then
            root.CFrame = root.CFrame * CFrame.Angles(0, math.pi, 0)
            flipped = true
        end
        if elapsed > 1.5 then
            hum.AutoRotate = true
            if conn then conn:Disconnect() end
        end
    end)
end

local kibaState = { alignPos = nil, alignOri = nil, conn = nil, part = nil }
local function kibaCleanup()
    if kibaState.alignPos then pcall(function() kibaState.alignPos:Destroy() end) end
    if kibaState.alignOri then pcall(function() kibaState.alignOri:Destroy() end) end
    if kibaState.conn then pcall(function() kibaState.conn:Disconnect() end) end
    if kibaState.part then pcall(function() kibaState.part:Destroy() end) end
    kibaState.alignPos, kibaState.alignOri, kibaState.conn, kibaState.part = nil, nil, nil, nil
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        for _, c in ipairs(root:GetChildren()) do
            if c:IsA("Attachment") or c.Name == "HasSnapped" then
                pcall(function() c:Destroy() end)
            end
        end
    end
end
local function kibaNearestTarget(maxDist)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local live = workspace:FindFirstChild("Live")
    if not live then return nil end
    local best, bestDist = nil, maxDist or 10
    for _, m in ipairs(live:GetChildren()) do
        if m:IsA("Model") and m ~= char then
            local hrp = m:FindFirstChild("HumanoidRootPart")
            local hum = m:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - root.Position).Magnitude
                if d <= bestDist then
                    if m.Name == "Weakest Dummy" or Players:GetPlayerFromCharacter(m) then
                        best, bestDist = hrp, d
                    end
                end
            end
        end
    end
    return best
end
