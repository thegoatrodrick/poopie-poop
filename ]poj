local function getNearestCharacter()
    local char = player.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if not hrp then return nil end
    local nearest = nil
    local shortestDistance = math.huge
    local liveFolder = workspace:FindFirstChild("Live")
    if liveFolder then
        for _, otherChar in ipairs(liveFolder:GetChildren()) do
            if otherChar:IsA("Model") and otherChar ~= char then
                local otherHRP = otherChar:FindFirstChild("HumanoidRootPart") or otherChar:FindFirstChild("Torso")
                local otherHum = otherChar:FindFirstChildOfClass("Humanoid")
                if otherHRP and otherHum and otherHum.Health > 0 then
                    local distance = (otherHRP.Position - hrp.Position).Magnitude
                    if distance < shortestDistance then shortestDistance = distance; nearest = otherHRP end
                end
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local otherHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local otherHum = p.Character:FindFirstChildOfClass("Humanoid")
            if otherHRP and otherHum and otherHum.Health > 0 then
                local distance = (otherHRP.Position - hrp.Position).Magnitude
                if distance < shortestDistance then shortestDistance = distance; nearest = otherHRP end
            end
        end
    end
    return nearest
end

local function jump30()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local target = getNearestCharacter()
    if not hrp or not target then return end
    local heightDifference = (target.Position.Y + 1) - hrp.Position.Y
    if heightDifference <= 0 then return end
    local gravity = workspace.Gravity
    local requiredVelocity = math.sqrt(2 * gravity * heightDifference)
    local velocity = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, requiredVelocity, velocity.Z)
end

local function jump50(num)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local velocity = hrp.AssemblyLinearVelocity
    hrp.AssemblyLinearVelocity = Vector3.new(velocity.X, num, velocity.Z)
end

local function fireDash()
    local character = player.Character or player.CharacterAdded:Wait()
    local remote = character:FindFirstChild("Communicate")
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer({ Dash = Enum.KeyCode.W, Key = Enum.KeyCode.Q, Goal = "KeyPress" })
    end
end

local autojump_oreo, autodash_oreo = true, true
local startdelay_oreo = 0.3
local oreojump = 30
local spinDuration, lockOnDuration = 0.3, 0.2
local forwardSpeed, constantSpin, endDashSpeed = 85, 1600, 100
local maxDetectionRadius = 150
local crystalSupaActive = true
local isLooping = false

local function getCharacterData()
    local char = player.Character
    if not char then return nil, nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if hrp and hum and hum.Health > 0 then return char, hrp, hum end
    return nil, nil, nil
end
local function getNearestPlayer(myRootPart)
    local closestPlayer, shortestDistance = nil, maxDetectionRadius
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer ~= player and otherPlayer.Character then
            local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
            local otherHum = otherPlayer.Character:FindFirstChild("Humanoid")
            if otherRoot and otherHum and otherHum.Health > 0 then
                local distance = (otherRoot.Position - myRootPart.Position).Magnitude
                if distance < shortestDistance then shortestDistance = distance; closestPlayer = otherPlayer end
            end
        end
    end
    return closestPlayer
end
local function executeCrystalSupa(num)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if autojump_oreo and hrp then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(0, 50000, 0); bv.Velocity = Vector3.new(0, num, 0); bv.Parent = hrp
        game:GetService("Debris"):AddItem(bv, 0.15)
    end
    task.wait(startdelay_oreo)
    local character, rootPart, humanoid = getCharacterData()
    if not character or isLooping then return end
    isLooping = true
    local originalState = humanoid:GetState()
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    fireDash()
    local timeElapsed = 0
    local cn
    cn = RunService.Heartbeat:Connect(function(delta)
        timeElapsed = timeElapsed + delta
        local modernChar, modernRoot, modernHum = getCharacterData()
        if not modernChar or modernHum.Health <= 0 or not crystalSupaActive then
            cn:Disconnect(); isLooping = false; return
        end
        modernHum.AutoRotate = false
        if timeElapsed <= spinDuration then
            modernRoot.CFrame = modernRoot.CFrame * CFrame.Angles(0, math.rad(constantSpin * delta), 0)
            modernRoot.AssemblyLinearVelocity = modernRoot.CFrame.LookVector * forwardSpeed
        elseif timeElapsed <= (spinDuration + lockOnDuration) then
            local targetPlayer = getNearestPlayer(modernRoot)
            if targetPlayer and targetPlayer.Character then
                local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    local flatTargetPos = Vector3.new(targetRoot.Position.X, modernRoot.Position.Y, targetRoot.Position.Z)
                    local dir = (flatTargetPos - modernRoot.Position).Unit
                    modernRoot.CFrame = CFrame.lookAt(modernRoot.Position, flatTargetPos)
                    modernRoot.AssemblyLinearVelocity = Vector3.new(dir.X * endDashSpeed, 0, dir.Z * endDashSpeed)
                end
            else
                local flatLook = Vector3.new(modernRoot.CFrame.LookVector.X, 0, modernRoot.CFrame.LookVector.Z).Unit
                modernRoot.AssemblyLinearVelocity = flatLook * endDashSpeed
            end
        else
            cn:Disconnect()
            modernRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            modernHum:ChangeState(originalState)
            modernHum.AutoRotate = true
            isLooping = false
        end
    end)
end
local function tpNearestPlayer()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local target = getNearestCharacter()
    if not hrp or not target then return end
    local position = target.Position + (-hrp.CFrame.LookVector) * 5
    hrp.CFrame = CFrame.new(position.X, hrp.Position.Y, position.Z)
end
local live = workspace:WaitForChild("Live")
local TWEEN_TIME, STAY_TIME, HEIGHT = 0.2, 0.1, 3
local busy = false
local function getNearestHead()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local nearestHead, shortestDistance = nil, math.huge
    for _, target in ipairs(live:GetChildren()) do
        if target ~= character then
            local head = target:FindFirstChild("Head")
            local humanoid = target:FindFirstChildOfClass("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local distance = (head.Position - root.Position).Magnitude
                if distance < shortestDistance then shortestDistance = distance; nearestHead = head end
            end
        end
    end
    return nearestHead
end
local function teleportToNearestHead()
    if busy then return end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local head = getNearestHead()
    if not root or not head then return end
    busy = true
    local tween = TweenService:Create(root, TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = CFrame.new(head.Position + Vector3.new(0, HEIGHT, 0)) })
    tween:Play(); tween.Completed:Wait()
    local elapsed = 0
    while elapsed < STAY_TIME do
        local dt = RunService.Heartbeat:Wait(); elapsed += dt
        if not root.Parent or not head.Parent then break end
        root.AssemblyLinearVelocity = Vector3.zero
        root.CFrame = CFrame.new(head.Position + Vector3.new(0, HEIGHT, 0))
    end
    busy = false
end
local function flipCamera()
    local cam = workspace.CurrentCamera
    local cf = cam.CFrame
    local pos = cf.Position
    local look = cf.LookVector
    local horizontal = Vector3.new(look.X, 0, look.Z)
    if horizontal.Magnitude < 0.001 then return end
    horizontal = -horizontal.Unit
    local pitch = math.asin(math.clamp(look.Y, -1, 1))
    local newLook = Vector3.new(horizontal.X * math.cos(pitch), look.Y, horizontal.Z * math.cos(pitch))
    cam.CFrame = CFrame.lookAt(pos, pos + newLook, Vector3.yAxis)
end
local function high(state)
    local nearest = nil
    local shortestDistance = math.huge
    if state then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, otherPlayer in ipairs(Players:GetPlayers()) do
            if otherPlayer ~= player then
                local otherChar = otherPlayer.Character
                local otherHRP = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
                local hum = otherChar and otherChar:FindFirstChildOfClass("Humanoid")
                if otherHRP and hum and hum.Health > 0 then
                    local distance = (otherHRP.Position - hrp.Position).Magnitude
                    if distance < shortestDistance then shortestDistance = distance; nearest = otherChar end
                end
            end
        end
    end
    if _G.NearestHighlight then _G.NearestHighlight:Destroy(); _G.NearestHighlight = nil end
    if state and nearest then
        local highlight = Instance.new("Highlight")
        highlight.Name = "NearestPlayerHighlight"
        highlight.FillColor = Color3.fromRGB(0, 255, 255); highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5; highlight.OutlineTransparency = 0
        highlight.Adornee = nearest; highlight.Parent = workspace
        _G.NearestHighlight = highlight
    end
end
local endleConnection
local generation = 0
local ANGLE, BACKWARD_OFFSET, HEIGHT_OFFSET = math.rad(0), 0, 1
local function endle(duration)
    generation += 1
    local myGeneration = generation
    if endleConnection then endleConnection:Disconnect(); endleConnection = nil end
    endleConnection = RunService.RenderStepped:Connect(function()
        if generation ~= myGeneration then return end
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local target = getNearestCharacter()
        if not root or not target then return end
        local look = camera.CFrame.LookVector
        local yaw = math.atan2(-look.X, -look.Z)
        local cameraRotation = CFrame.Angles(0, yaw, 0)
        local backward = cameraRotation.LookVector * -BACKWARD_OFFSET
        local targetPosition = target.Position + backward + Vector3.new(0, HEIGHT_OFFSET, 0)
        root.CFrame = CFrame.new(targetPosition) * cameraRotation * CFrame.Angles(ANGLE, 0, 0)
    end)
    task.delay(math.max(0, duration), function()
        if generation == myGeneration then
            if endleConnection then endleConnection:Disconnect(); endleConnection = nil end
        end
    end)
end
local function toggleCameraFace()
    enabled = not enabled
    RunService:UnbindFromRenderStep("CameraFace")
    if connection then connection:Disconnect(); connection = nil end
    if not enabled then return end
    RunService:BindToRenderStep("CameraFace", Enum.RenderPriority.Camera.Value + 1, function()
        local cam = workspace.CurrentCamera
        local character = player.Character
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local target = getNearestCharacter()
        if not cam or not hrp or not target then return end
        if (target.Position - hrp.Position).Magnitude <= 0.2 then
            enabled = false; RunService:UnbindFromRenderStep("CameraFace"); endle(0.2); return
        end
        cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, target.Position), 0.85)
    end)
end
