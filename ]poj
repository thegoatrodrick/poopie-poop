local function resolveCharacter(obj)
    if not obj then return nil end
    if typeof(obj) == "Instance" then
        if obj:IsA("Player") then return obj.Character end
        if obj:IsA("Model") then return obj end
        if obj:IsA("BasePart") then return obj end
    end
    return nil
end
local function isAlive(obj)
    if not obj then return false end
    if obj:IsA("Player") then
        local ch = obj.Character
        if not ch then return false end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        return hum ~= nil and hum.Health > 0
    end
    if obj:IsA("Model") then
        local hum = obj:FindFirstChildOfClass("Humanoid")
        return hum ~= nil and hum.Health > 0
    end
    return false
end
local function getName(obj)
    if not obj then return "Unknown" end
    if typeof(obj) == "Instance" then return obj.Name end
    return tostring(obj)
end
local function isSameTeam(p)
    if not (LocalPlayer_esp and p) then return false end
