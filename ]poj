local function startCandyFarm()
    if candyFarmActive then return end
    candyFarmActive = true
    shared.candy = true
    candyStartTime = os.clock()
    candyCollected = 0
    enableFarmHelpers()
    if candyFarm1RespawnConn then candyFarm1RespawnConn:Disconnect() end
    candyFarm1RespawnConn = player.CharacterAdded:Connect(function(newChar)
        if not candyFarmActive then return end
        local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
        if hrp and candyFarmActive then
            hrp.CFrame = candyFarm1Idle
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    candyGui = Instance.new("ScreenGui")
    candyGui.Name = "CrystalCandyFarm"
    candyGui.IgnoreGuiInset = true
    candyGui.DisplayOrder = 999999
    candyGui.ResetOnSpawn = false
    candyGui.Parent = player:WaitForChild("PlayerGui")
    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.Parent = candyGui
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 50)
    title.Position = UDim2.new(0, 0, 0.25, 0)
    title.BackgroundTransparency = 1
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 32
    title.Text = "Crystal hub candy farm"
    title.Parent = bg
    local stats = Instance.new("TextLabel")
    stats.Size = UDim2.new(1, 0, 0, 150)
    stats.Position = UDim2.new(0, 0, 0.35, 0)
    stats.BackgroundTransparency = 1
    stats.TextColor3 = Color3.new(0, 1, 0)
    stats.Font = Enum.Font.Code
    stats.TextSize = 24
    stats.Text = "Candy farmed: 0\nCandy: 0\nTime farmed: 0s"
    stats.Parent = bg
    local startAttr = player:GetAttribute("Candy") or 0
    candyConn = player:GetAttributeChangedSignal("Candy"):Connect(function()
        local now = player:GetAttribute("Candy") or 0
        if now > startAttr then
            candyCollected = candyCollected + (now - startAttr)
            startAttr = now
        end
    end)
    task.spawn(function()
        local idle = candyFarm1Idle
        local old = workspace.FallenPartsDestroyHeight
        local h = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if h then
            h.CFrame = CFrame.new(-90, 0, 0)
            task.wait(0.1)
            workspace.FallenPartsDestroyHeight = math.huge
            task.wait(0.05)
            workspace.FallenPartsDestroyHeight = old
        end
        local minX, maxX = -552, 552
        local minY, maxY = 134, 752
        local minZ, maxZ = 2458, 3536
        local function inZone(pos)
            return pos.X >= minX and pos.X <= maxX and pos.Y >= minY and pos.Y <= maxY and pos.Z >= minZ and pos.Z <= maxZ
        end
        local lastPos, trust, fails = {}, {}, {}
        local lastVisited = nil
        local framesOnLast = 0
        while candyFarmActive do
            local elapsed = os.clock() - candyStartTime
            stats.Text = "Candy farmed: " .. candyCollected .. "\nCandy: " .. (player:GetAttribute("Candy") or 0) .. "\nTime farmed: " .. math.floor(elapsed) .. "s"
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then
                lastVisited = nil; framesOnLast = 0; task.wait(0.1); continue
            end
            if lastVisited and lastVisited.Parent then
                framesOnLast = framesOnLast + 1
                if framesOnLast < 8 then
                    hrp.CFrame = CFrame.new(lastVisited.Position - Vector3.new(0, 4, 0))
                    task.wait(); continue
                else
                    fails[lastVisited] = (fails[lastVisited] or 0) + 1
                    lastVisited = nil; framesOnLast = 0
                end
            end
            local visuals = workspace:FindFirstChild("CandyVisuals")
            if visuals then
                local list = {}
                for _, candy in ipairs(visuals:GetChildren()) do
                    if candy:IsA("BasePart") and candy.Parent and candy.Position.Y > 50 and not inZone(candy.Position) and (fails[candy] or 0) < 5 then
                        local prev = lastPos[candy]
                        local pos = candy.Position
                        local moving = prev and (pos - prev).Magnitude > 0.5
                        lastPos[candy] = pos
                        if not moving then trust[candy] = math.min((trust[candy] or 0) + 1, 100)
                        else trust[candy] = 0 end
                        if trust[candy] >= 1 then
                            table.insert(list, {candy = candy, grounded = trust[candy] >= 3})
                        end
                    end
                end
                table.sort(list, function(a, b)
                    if a.grounded ~= b.grounded then return a.grounded end
                    return (fails[a.candy] or 0) < (fails[b.candy] or 0)
                end)
                if #list > 0 then
                    lastVisited = list[1].candy
                    framesOnLast = 0
                    hrp.CFrame = CFrame.new(lastVisited.Position - Vector3.new(0, 4, 0))
                    shared.candyFarm1Away = true
                else
                    hrp.CFrame = idle; lastVisited = nil
                    shared.candyFarm1Away = false
                end
            else hrp.CFrame = idle; shared.candyFarm1Away = false end
            task.wait()
        end
    end)
end

