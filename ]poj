local candyFarmActive = false
local candyConn = nil
local candyGui = nil
local candyStartTime = 0
local candyCollected = 0
local candyFarm1Idle = CFrame.new(-42, 1855, 25227)
local candyFarm1RespawnConn = nil

local function stopCandyFarm()
