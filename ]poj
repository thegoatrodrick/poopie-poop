pcall(function()
    task.defer(function()
        local pg = player:FindFirstChild("PlayerGui")
        if not pg then return end
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and (g.Name:lower():find("wind") or g.Name:find("luACRystal") or g.Name:Find("MySuperHub")) then
                g.Destroying:Connect(forceCleanup)
                g.AncestryChanged:Connect(function(_, parent) if not parent then forceCleanup() end end)
            end
        end
    end)
end)
