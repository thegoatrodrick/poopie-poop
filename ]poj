local _magnetEnabled = false
local _magnetActive = false
local _magnetStartTime = 0
local _magnetDuration = 0.5
local _magnetStrength = 50
local _magnetHeight = 2
local _magnetReach = 100
local _magnetSmoothness = 0.65
local _magnetDashCancel = true
local _magnetConn = nil
local _magnetTargetOverride = nil

local function _getMagnetTarget()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local farthest = _magnetReach
    local best = nil
    local liveFolder = workspace:FindFirstChild("Live")
    if liveFolder then
        for _, m in ipairs(liveFolder:GetChildren()) do
            if m:IsA("Model") and m ~= char then
                local mHRP = m:FindFirstChild("HumanoidRootPart")
                local mHum = m:FindFirstChildOfClass("Humanoid")
                if mHRP and mHum and mHum.Health > 0 then
                    local d = (hrp.Position - mHRP.Position).Magnitude
                    if d < farthest and d > 0.1 then farthest = d; best = mHRP end
                end
            end
        end
    end
    if not best then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local mHRP = p.Character:FindFirstChild("HumanoidRootPart")
                local mHum = p.Character:FindFirstChildOfClass("Humanoid")
                if mHRP and mHum and mHum.Health > 0 then
                    local d = (hrp.Position - mHRP.Position).Magnitude
                    if d < farthest and d > 0.1 then farthest = d; best = mHRP end
                end
            end
        end
    end
    return best
end
local function _magnetStep()
    if not _magnetActive then
        if _magnetConn then _magnetConn:Disconnect(); _magnetConn = nil end
        return
    end
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        if _magnetConn then _magnetConn:Disconnect(); _magnetConn = nil end
        _magnetActive = false; return
    end
    if tick() - _magnetStartTime >= _magnetDuration then
        if _magnetConn then _magnetConn:Disconnect(); _magnetConn = nil end
        _magnetActive = false; return
    end
    local target = (_magnetTargetOverride and _magnetTargetOverride.Parent and _magnetTargetOverride) or _getMagnetTarget()
    if not target then return end
    local myPos = hrp.Position
    local flat = Vector3.new(target.Position.X, myPos.Y, target.Position.Z)
    local dir = flat - myPos
    if dir.Magnitude > 1 then
        dir = dir.Unit
        local targetVel = dir * _magnetStrength
        local currentVel = hrp.AssemblyLinearVelocity
        local newVel = currentVel:Lerp(targetVel, _magnetSmoothness)
        hrp.AssemblyLinearVelocity = Vector3.new(newVel.X * 0.85, currentVel.Y, newVel.Z * 0.85)
    end
end
local function _magnetStartPull(override)
    if _magnetConn then _magnetConn:Disconnect(); _magnetConn = nil end
    _magnetStartTime = tick()
    _magnetTargetOverride = override
    _magnetActive = true
    _magnetStep()
    _magnetConn = RunService.Heartbeat:Connect(_magnetStep)
end
local function _magnetExecute(target)
    if not _magnetEnabled then return end
    if not _magnetActive then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return end
        if _magnetDashCancel then
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("BodyVelocity") or child:IsA("LinearVelocity") then child:Destroy() end
            end
            local v = hrp.AssemblyLinearVelocity
            hrp.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
        end
        local tg = (target and target.Parent and target) or _getMagnetTarget()
        if tg then
            local dest = tg.Position + Vector3.new(0, _magnetHeight, 0)
            hrp.CFrame = CFrame.new(dest.X, dest.Y, dest.Z)
            _magnetStartPull(tg)
        end
    end
end
